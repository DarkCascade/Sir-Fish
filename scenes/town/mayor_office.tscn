; [mayor notice board] The board's frame: the theme's 10px gold panel edge and
; no fill. The wood (Board/Grain, CC0 Wood060) draws BEHIND this edge via
; show_behind_parent, inset by these content margins - exactly the border width,
; so the grain's square corners tuck under the rounded gold band.
[sub_resource type="StyleBoxFlat" id="board"]
content_margin_left = 10.0
content_margin_top = 10.0
content_margin_right = 10.0
content_margin_bottom = 10.0
draw_center = false
border_width_left = 10
border_width_top = 10
border_width_right = 10
border_width_bottom = 10
border_color = Color(0.831373, 0.658824, 0.262745, 1)
corner_radius_top_left = 22
corner_radius_top_right = 22
corner_radius_bottom_right = 22
corner_radius_bottom_left = 22

; An empty notice-sized outline in C_TEXT_GOLD at 45% - a gap, not a card.
[sub_resource type="StyleBoxFlat" id="dawn_slip"]
content_margin_left = 28.0
content_margin_top = 28.0
content_margin_right = 28.0
content_margin_bottom = 28.0
draw_center = false
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(0.937255, 0.839216, 0.580392, 0.45)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

; The sheet's paper, in layers so the texture can sit inside an inked edge:
; Paper draws only the drop shadow (a transparent box), Paper/Frame draws only
; the 6px ink edge, and Paper/Frame/Texture (CC0 Paper002) draws behind that
; edge, inset by its 6px content margin - corners tuck under the band as on
; the board.
[sub_resource type="StyleBoxFlat" id="paper_shadow"]
bg_color = Color(0, 0, 0, 0)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
shadow_color = Color(0, 0, 0, 0.45)
shadow_size = 1
shadow_offset = Vector2(0, 16)

[sub_resource type="StyleBoxFlat" id="paper_frame"]
content_margin_left = 6.0
content_margin_top = 6.0
content_margin_right = 6.0
content_margin_bottom = 6.0
draw_center = false
border_width_left = 6
border_width_top = 6
border_width_right = 6
border_width_bottom = 6
border_color = Color(0.141176, 0.117647, 0.0784314, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="pin"]
bg_color = Color(0.847059, 0.686275, 0.321569, 1)
border_width_left = 6
border_width_top = 6
border_width_right = 6
border_width_bottom = 6
border_color = Color(0.478431, 0.352941, 0.0941176, 1)
corner_radius_top_left = 22
corner_radius_top_right = 22
corner_radius_bottom_right = 22
corner_radius_bottom_left = 22

