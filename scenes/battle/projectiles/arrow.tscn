[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/battle/projectile.gd" id="1_proj"]
[ext_resource type="Shader" path="res://assets/shaders/cel_shade.gdshader" id="2_cel"]
[ext_resource type="Shader" path="res://assets/shaders/outline.gdshader" id="3_outline"]

; The arrow's three parts are authored here rather than built in _ready(), so
; the shaft, fletching and tip can be re-proportioned and recoloured in the
; inspector. bomb_arrow.tscn INHERITS this scene and adds the bag, fuse, spark,
; trail and fuse light on top - edit the shaft here and both arrows follow.
;
; The mesh lies along +X so projectile.gd's rotation.z aims it along the flight
; path; the root's 1.8 scale is the overhead camera's legibility scale (it was
; VIEW_SCALE in code). Materials are the cel + ink-outline pair CelMaterials.cel
; builds, at the 0.010 outline width projectiles use.

[sub_resource type="ShaderMaterial" id="outline_mat"]
shader = ExtResource("3_outline")
shader_parameter/outline_color = Color(0.141176, 0.117647, 0.078431, 1)
shader_parameter/outline_width = 0.01
shader_parameter/alpha = 1.0

