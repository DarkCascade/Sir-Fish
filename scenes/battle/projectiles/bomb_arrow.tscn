[gd_scene format=3]

[ext_resource type="PackedScene" path="res://scenes/battle/projectiles/arrow.tscn" id="1_arrow"]
[ext_resource type="Shader" path="res://assets/shaders/cel_shade.gdshader" id="2_cel"]
[ext_resource type="Shader" path="res://assets/shaders/outline.gdshader" id="3_outline"]

; Inherits arrow.tscn (shaft / fletching / tip) and adds the bomb's own parts,
; so a change to the arrow itself lands on both projectiles. Everything here is
; inspector-editable: the powder bag, the fuse and its spark, the fuse light,
; and the trail.
;
; Spec 9.6: the plain arrow deliberately has NO trail - "trail or no trail" is
; what tells the two apart in flight, which is the whole point of the telegraph.
; Do not add one to arrow.tscn.

