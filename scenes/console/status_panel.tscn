; [slot ui phase 3] Gold AND scrap now - the HUD's corner CurrencyPlate hides for
; the whole quest (hud.gd), so this plate is the expedition's only readout of
; either. The plate keeps the old frame's footprint, the left 80% of GoldPlate's
; box, so Sir Fish's tank does not move.
;
; Vines is the item card's gold-vine nine-patch at 0.4 scale: anchors of 0.8/0.4
; = 2.0 across and 1/0.4 = 2.5 down, so the 75 px band draws as 30 px.
[node name="Face" type="Panel" parent="Layout/ResourceRow/GoldPlate"]
layout_mode = 1
anchors_preset = -1
anchor_right = 0.8
anchor_bottom = 1.0
offset_left = 8.0
offset_top = 8.0
offset_right = -8.0
offset_bottom = -8.0
mouse_filter = 2
theme_override_styles/panel = SubResource("plate_face")

