[ext_resource type="Shader" path="res://assets/shaders/black_glass_tint.gdshader" id="4_tint"]

; [black-glass] One tint per button, shared by the art and its meter so the render's
; baked gold and the drawn pips shift together. Local to scene so each of the
; tray's three instances owns its own copy; special_invoker.gd drives boss_mix.
[sub_resource type="ShaderMaterial" id="ShaderMaterial_tint"]
