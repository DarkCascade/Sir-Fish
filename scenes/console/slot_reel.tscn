[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/console/slot_reel.gd" id="1_reel"]
[ext_resource type="PackedScene" path="res://scenes/console/slot_symbol.tscn" id="2_symbol"]

; [move-elements-to-editor] The five visible cells are authored instances so the
; reel opens in the editor (see reel_layout_playground.tscn); each cell's
; `box_fraction` is an inspector property, and adding a pair above and below is
; two duplicated nodes here, no code change.
;
; Their POSITION is driven every frame by slot_reel.gd: the reel scrolls, so
; where a cell sits is a function of position_stops. Cell2 is the payline cell -
; the middle of however many there are.
;
; [slot phase 2] The cells carry no authored icon any more - the reel deals one
; onto each from the bag every spin (slot_reel.gd's _layout / _strip). In the
; editor, set a cell's `preview_id` to eyeball a chip.

[node name="Reel" type="Control"]
custom_minimum_size = Vector2(40, 120)
offset_right = 240.0
offset_bottom = 720.0
mouse_filter = 2
clip_contents = true
script = ExtResource("1_reel")

[node name="Cell0" parent="." instance=ExtResource("2_symbol")]
offset_top = -240.0
offset_bottom = 0.0

[node name="Cell1" parent="." instance=ExtResource("2_symbol")]
offset_top = 0.0
offset_bottom = 240.0

[node name="Cell2" parent="." instance=ExtResource("2_symbol")]
offset_top = 240.0
offset_bottom = 480.0

[node name="Cell3" parent="." instance=ExtResource("2_symbol")]
offset_top = 480.0
offset_bottom = 720.0

[node name="Cell4" parent="." instance=ExtResource("2_symbol")]
offset_top = 720.0
offset_bottom = 960.0
