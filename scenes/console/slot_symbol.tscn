[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/console/slot_symbol.gd" id="1_sym"]
[ext_resource type="StyleBox" path="res://resources/ui/slot_tile_rootwood.tres" id="2_tile"]

; [rootwood-canopy] tile_style is the rootwood, gold-rimmed tile every dealt icon
; sits on - the board's own permanent look, since it never renders outside a
; quest. resources/ui/slot_tile.tres (plum) is the SAME shape, used instead by
; the party modal's reel-icon chips when that modal is opened in town - see
; party_modal.gd's SLOT_TILE_ROOTWOOD. Blank cells draw no tile.

[node name="SlotSymbol" type="Control"]
custom_minimum_size = Vector2(40, 40)
offset_right = 240.0
offset_bottom = 240.0
pivot_offset = Vector2(120, 120)
mouse_filter = 2
script = ExtResource("1_sym")
tile_style = ExtResource("2_tile")
