; [expedition phase II] The RUNE_FLOOR expedition (PRD §5.1), routed to for a
; quest whose style resolves to RUNE_FLOOR (SceneRouter.PATHS[Place.QUEST]). The
; world takes the whole 1080 x 1920 screen; the plate dock floats over the bottom
; band and a thin top bar under the Hud's own bag / party / minimap row. The real
; SlotMachine lives in HiddenCabinet, never drawn - RuneFloor mirrors its board
; onto the ground. RunController, last, drives it all through the root's
; ExpeditionPresentation half.
;
; Hand-written with comments: edit on disk and reload, never save it through the
; editor (CLAUDE.md, godot-ai rule 3).

[sub_resource type="ShaderMaterial" id="vignette_mat"]
shader = ExtResource("7_vignette")
shader_parameter/tint = Color(0.01, 0.03, 0.04, 1)
shader_parameter/inner = 0.62
shader_parameter/outer = 1.25
shader_parameter/strength = 0.55
shader_parameter/top_bias = 0.0
shader_parameter/aspect = Vector2(1, 1.778)

[sub_resource type="Gradient" id="top_grad"]
offsets = PackedFloat32Array(0, 0.7, 1)
colors = PackedColorArray(0.016, 0.027, 0.035, 0.92, 0.016, 0.027, 0.035, 0.6, 0.016, 0.027, 0.035, 0)

[sub_resource type="GradientTexture2D" id="top_tex"]
gradient = SubResource("top_grad")
width = 4
height = 64
fill_to = Vector2(0, 1)

[sub_resource type="StyleBoxFlat" id="dock_style"]
bg_color = Color(0.078, 0.059, 0.11, 1)
border_width_top = 6
border_color = Color(0.847, 0.686, 0.322, 1)

