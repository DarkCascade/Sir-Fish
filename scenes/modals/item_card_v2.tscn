size_flags_vertical = 0
theme_override_constants/separation = 8

; The height is pinned to what the name occupies at the 54 size ceiling, because
; _fit_name picks the size a frame LATER and the card's own height is derived
; from this content - an unpinned label would shrink the card under a long name
; and leave every row in a list a slightly different height.
[node name="NameLabel" type="Label" parent="Card/Content/Layout" unique_id=1943528179]
