; The no-modifier floor, and what the editor previews: a 74px name at the 54
; size ceiling, 8 separation and a 234px TopRow (the medallion column sets that
; floor), plus the two 40px Content margins. setup() RAISES this per item, since
; the modifier list runs 0-3 rows - see the derivation there. The v2 stat tiles
; sit BESIDE the medallion rather than in a row under it, which is what buys
; back the 110px the old 510 needed.
[node name="Card" type="Control" parent="." unique_id=246588221]
custom_minimum_size = Vector2(0, 400)
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="Backing" type="PanelContainer" parent="Card" unique_id=171392484]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 21.0
offset_top = 21.0
offset_right = -21.0
offset_bottom = -21.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("backing")

[node name="Content" type="MarginContainer" parent="Card" unique_id=1998999149]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 40

[node name="Layout" type="VBoxContainer" parent="Card/Content" unique_id=879346019]
