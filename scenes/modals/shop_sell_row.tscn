; [meshy-experiment] Full rebuild applying the Buy tab's card frame to the
; Sell tab (icon medallion + info + a full-width primary bar, with Compare
; behind a swipe - see shop_buy_card.tscn's header). Equip stays a small,
; always-visible button next to the swipe-only Compare, since it is a real
; gameplay action players reach for often, not just information.
[node name="ShopSellRow" type="PanelContainer"]
custom_minimum_size = Vector2(880, 300)
offset_right = 880.0
offset_bottom = 300.0
clip_contents = true
mouse_filter = 1
script = ExtResource("1_row")

[node name="Stage" type="Control" parent="."]
layout_mode = 2
mouse_filter = 1
script = ExtResource("4_stage")

[node name="ActionLayer" type="Control" parent="Stage"]
layout_mode = 1
anchor_left = 0.0
anchor_top = 0.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 0.0
offset_top = 0.0
offset_right = 0.0
offset_bottom = 0.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="ActionButton" type="Button" parent="Stage/ActionLayer"]
layout_mode = 1
anchor_left = 1.0
anchor_top = 0.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -184.0
offset_top = 0.0
offset_right = 0.0
offset_bottom = 0.0
grow_horizontal = 0
grow_vertical = 2
mouse_filter = 0
theme_override_colors/font_color = Color(0.858824, 0.945098, 1, 1)
theme_override_colors/font_hover_color = Color(1, 1, 1, 1)
theme_override_colors/font_pressed_color = Color(0.74902, 0.933333, 1, 1)
theme_override_font_sizes/font_size = 30
theme_override_styles/normal = SubResource("action_normal")
theme_override_styles/hover = SubResource("action_hover")
theme_override_styles/pressed = SubResource("action_pressed")
