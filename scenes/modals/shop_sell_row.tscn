; Swapped in for SellLabel/Divider/CoinGlyph/AmountLabel (see shop_sell_row.gd's
; _refresh_sell_state()) while the item is equipped - a plain Label rather
; than DisplayLabel's serif face, and a smaller size, because "Must Unequip
; to Sell" is far longer than "SELL | 24" and needs to read as a status
; message, not a second call to action.
[node name="LockedLabel" type="Label" parent="Stage/Face/FaceLayout/SellBar/Content"]
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.611765, 0.686275, 0.643137, 1)
theme_override_font_sizes/font_size = 32
text = "Must Unequip to Sell"
vertical_alignment = 1
