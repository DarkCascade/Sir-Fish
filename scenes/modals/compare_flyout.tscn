[gd_scene format=3]

; [reliquary] Re-dressed from the teal/gold "well" look to the modal layer's
; arcane-reliquary chrome: a plum-black panel under a crystal/thorn corner
; frame overlay, recessed amethyst-trimmed wells, a crystal-rimmed X, and
; violet fog drifting behind the scrim. The panel / well / close styleboxes are
; inlined per scene, matching this project's existing convention (see
; inventory_modal.tscn) - the Godot editor keeps a shared theme.tres cached and
; overwrites out-of-editor edits to it, so per-scene is the safe home.

; [item-row] Now the DETAIL VIEW, opened by tapping a strip in any list, rather
; than a dialog reached by a Compare button. Two things changed with that.
;
; The two side-by-side wells are gone. Showing both items in full and letting
; the change list underneath do the subtraction meant the same rolls were drawn
; three times over; the candidate is shown once, in the header, and every number
; below it is already the comparison. The verdict word replaces the static
; "COMPARE" title, so the conclusion is the first thing read rather than
; something assembled from the rows.
;
; The header's headline figure is the item's characteristic magnitude - the base
; slot icon's value - NOT that plus its modifier rolls. A modifier is its own
; icon in the bag; summing the two would print a number the game never computes.
; See ItemCompare.headline_value.

[ext_resource type="Script" path="res://scripts/modals/compare_flyout.gd" id="1_flyout"]
[ext_resource type="Shader" path="res://assets/shaders/reliquary_mist.gdshader" id="2_mist"]
[ext_resource type="PackedScene" path="res://scenes/modals/reliquary_frame.tscn" id="3_frame"]
[ext_resource type="Texture2D" path="res://assets/ui/reliquary/fleuron.png" id="4_fleuron"]
[ext_resource type="Script" uid="uid://cqeao7bjt6s2m" path="res://scripts/modals/item_glyph.gd" id="5_glyph"]
[ext_resource type="Texture2D" uid="uid://dqcrm8u30i7sv" path="res://assets/ui/reliquary/card_medallion.png" id="6_medallion"]

[sub_resource type="ShaderMaterial" id="mist_mat"]
shader = ExtResource("2_mist")
shader_parameter/fog_color = Color(0.545, 0.361, 0.965, 1.0)
shader_parameter/deep_color = Color(0.141, 0.082, 0.239, 1.0)
shader_parameter/density = 0.34
shader_parameter/drift_speed = 0.045
shader_parameter/scale = 2.4

; Tuning.C_RELIQUARY_STONE fill, pewter trim. Content margin clears the Meshy
; corner-frame art drawn on top.
[sub_resource type="StyleBoxFlat" id="rel_panel"]
content_margin_left = 72.0
content_margin_top = 48.0
content_margin_right = 72.0
content_margin_bottom = 52.0
bg_color = Color(0.101961, 0.082353, 0.14902, 1)
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(0.227451, 0.227451, 0.282353, 1)
corner_radius_top_left = 22
corner_radius_top_right = 22
corner_radius_bottom_right = 22
corner_radius_bottom_left = 22

; Recessed well, one step darker than the panel, trimmed in deep amethyst. One
; change row wears it; RowTemplate is duplicated per row so the styling stays
; authored here rather than rebuilt in code.
[sub_resource type="StyleBoxFlat" id="rel_well"]
content_margin_left = 20.0
content_margin_top = 12.0
content_margin_right = 20.0
content_margin_bottom = 12.0
bg_color = Color(0.054902, 0.043137, 0.086275, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.298039, 0.113725, 0.584314, 1)
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14

; The round crystal-rimmed X. Same disc every modal's close button wears.
[sub_resource type="StyleBoxFlat" id="rel_close"]
bg_color = Color(0.054902, 0.043137, 0.086275, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.545098, 0.360784, 0.964706, 1)
corner_radius_top_left = 36
corner_radius_top_right = 36
corner_radius_bottom_right = 36
corner_radius_bottom_left = 36

[node name="CompareFlyout" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
script = ExtResource("1_flyout")

[node name="Scrim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.141176, 0.094118, 0.196078, 0.72)

; Drifting violet fog, procedural (assets/shaders/reliquary_mist.gdshader) - no
; generated art needed. Sits above the flat scrim, below the panel.
[node name="Mist" type="ColorRect" parent="."]
material = SubResource("mist_mat")
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(1, 1, 1, 1)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -470.0
offset_top = -350.0
offset_right = 470.0
offset_bottom = 350.0
grow_horizontal = 2
grow_vertical = 2
pivot_offset = Vector2(470, 350)
theme_override_styles/panel = SubResource("rel_panel")

[node name="Layout" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Header" type="HBoxContainer" parent="Panel/Layout"]
custom_minimum_size = Vector2(0, 76)
layout_mode = 2
theme_override_constants/separation = 16

; [item-row] Was a static "COMPARE". The verdict IS this dialog's title now -
; UPGRADE / MIXED / WORSE / NO CHANGE / NEW / EQUIPPED - so the answer is read
; before any row is. Sign-only, never a weighted score; see ItemCompare.verdict.
[node name="VerdictLabel" type="Label" parent="Panel/Layout/Header"]
layout_mode = 2
theme_type_variation = &"DisplayLabel"
theme_override_colors/font_color = Color(0.847059, 0.705882, 0.996078, 1)
theme_override_font_sizes/font_size = 64
text = "UPGRADE"
vertical_alignment = 1

; Which hero this comparison is even about. Right-aligned against the close
; button rather than given its own line - it is a qualifier on the verdict, not
; a statement of its own.
[node name="ForLabel" type="Label" parent="Panel/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 40
horizontal_alignment = 2
vertical_alignment = 1

[node name="CloseButton" type="Button" parent="Panel/Layout/Header"]
custom_minimum_size = Vector2(72, 72)
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.94902, 0.913725, 0.815686, 1)
theme_override_colors/font_hover_color = Color(0.847059, 0.705882, 0.996078, 1)
theme_override_colors/font_pressed_color = Color(0.545098, 0.360784, 0.964706, 1)
theme_override_font_sizes/font_size = 54
theme_override_styles/normal = SubResource("rel_close")
theme_override_styles/hover = SubResource("rel_close")
theme_override_styles/pressed = SubResource("rel_close")
text = "X"

; Full width, ABOVE the medallion row rather than sharing a column with it. The
; display font runs about 0.83em per character, so a generated name needs most
; of the panel's 796px interior: sharing the row left it roughly 440px, and
; names as short as "Weeping Blade" wrapped to two lines there.
[node name="NameLabel" type="Label" parent="Panel/Layout"]
layout_mode = 2
theme_type_variation = &"DisplayLabel"
theme_override_font_sizes/font_size = 46
text = "Grumbling Longsword"
autowrap_mode = 3

; Identity and headline. The medallion is the list strip's ring at full size, so
; the row and the detail it opens are visibly the same item.
[node name="Hero" type="HBoxContainer" parent="Panel/Layout"]
layout_mode = 2
theme_override_constants/separation = 20

; 140, not the card's 180: what is left after the headline figure has its column
; still has to seat two lines of body text without wrapping them.
[node name="Medallion" type="Control" parent="Panel/Layout/Hero"]
custom_minimum_size = Vector2(140, 140)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2

[node name="Glyph" type="Control" parent="Panel/Layout/Hero/Medallion"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -40.0
offset_top = -40.0
offset_right = 40.0
offset_bottom = 40.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("5_glyph")

[node name="Ring" type="TextureRect" parent="Panel/Layout/Hero/Medallion"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("6_medallion")
expand_mode = 1
stretch_mode = 5

[node name="Identity" type="VBoxContainer" parent="Panel/Layout/Hero"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 4

[node name="MetaLabel" type="Label" parent="Panel/Layout/Hero/Identity"]
layout_mode = 2
theme_override_colors/font_color = Color(0.709804, 0.823529, 0.784314, 1)
theme_override_font_sizes/font_size = 30
text = "Rare Sword  ·  Lv 7  ·  Warrior"
autowrap_mode = 3

; "replacing Fat Blade (Lv 5)", or what stands in for it when there is nothing
; in the slot. The comparison's other half, named rather than drawn as a second
; full column of its own.
[node name="RivalLabel" type="Label" parent="Panel/Layout/Hero/Identity"]
layout_mode = 2
theme_override_colors/font_color = Color(0.611765, 0.690196, 0.67451, 1)
theme_override_font_sizes/font_size = 30
text = "replacing Fat Blade (Lv 5)"
autowrap_mode = 3

[node name="Headline" type="VBoxContainer" parent="Panel/Layout/Hero"]
custom_minimum_size = Vector2(170, 0)
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 0

[node name="Value" type="Label" parent="Panel/Layout/Hero/Headline"]
layout_mode = 2
theme_override_colors/font_color = Color(0.937255, 0.839216, 0.580392, 1)
theme_override_font_sizes/font_size = 88
text = "58"
horizontal_alignment = 2

[node name="Unit" type="Label" parent="Panel/Layout/Hero/Headline"]
