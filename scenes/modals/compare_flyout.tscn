[node name="RuleL" type="HSeparator" parent="Panel/Layout/Divider"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4

[node name="Fleuron" type="TextureRect" parent="Panel/Layout/Divider"]
