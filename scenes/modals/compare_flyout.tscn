stretch_mode = 5

[node name="RuleR" type="HSeparator" parent="Panel/Layout/Divider"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4

[node name="ChangeHeader" type="Label" parent="Panel/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.847059, 0.705882, 0.996078, 1)
theme_override_font_sizes/font_size = 40
text = "IF YOU EQUIP THIS"

[node name="ChangeList" type="VBoxContainer" parent="Panel/Layout"]
custom_minimum_size = Vector2(0, 190)
layout_mode = 2
theme_override_constants/separation = 6

; Hidden master copy, duplicated once per change row. Authored rather than
; built in code so the well styling, the column widths and the font sizes all
; stay inspector-editable (CLAUDE.md best practice 1).
[node name="RowTemplate" type="PanelContainer" parent="Panel/Layout/ChangeList"]
visible = false
layout_mode = 2
theme_override_styles/panel = SubResource("rel_well")

[node name="Box" type="HBoxContainer" parent="Panel/Layout/ChangeList/RowTemplate"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Icon" type="TextureRect" parent="Panel/Layout/ChangeList/RowTemplate/Box"]
