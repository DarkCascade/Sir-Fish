size_flags_vertical = 4
theme_override_colors/font_color = Color(0.94902, 0.913725, 0.815686, 1)
theme_override_font_sizes/font_size = 34
text = "Weapon Damage"
clip_text = true
text_overrun_behavior = 3

; The candidate's own magnitude, so the row says what the item HAS as well as
; what it would change - a delta alone cannot answer "how big is this".
[node name="Value" type="Label" parent="Panel/Layout/ChangeList/RowTemplate/Box"]
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.937255, 0.839216, 0.580392, 1)
theme_override_font_sizes/font_size = 38
text = "58"
horizontal_alignment = 2

[node name="Delta" type="Label" parent="Panel/Layout/ChangeList/RowTemplate/Box"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
size_flags_vertical = 4
theme_override_font_sizes/font_size = 38
text = "+12"
horizontal_alignment = 2

; [reliquary] Corner ornaments, as a sibling overlaying the panel exactly so
; the PanelContainer content margin does not inset them off the panel edge.
[node name="Frame" parent="." instance=ExtResource("3_frame")]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -470.0
offset_top = -350.0
offset_right = 470.0
offset_bottom = 350.0
