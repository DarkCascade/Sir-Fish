[gd_scene load_steps=4 format=3]

; [ui-project-longshot] Was a 560 x 460 stack of labels - "Equipped" above
; "This Item", read top to bottom, dismissed only by tapping the scrim. It is
; reached by a deliberate button press now (shop_buy_card / shop_sell_row's
; CompareButton) rather than by a stray tap on a card, so it is dressed as the
; dialog it always actually was: titled, closable, and laid out as an actual
; COMPARISON - the two items side by side in matching wells, with the change
; each modifier would undergo spelled out underneath.

[ext_resource type="Script" path="res://scripts/modals/compare_flyout.gd" id="1_flyout"]

; The same dark stone disc with a gold rim the shop's own X wears
; (shop_modal.tscn) - one close affordance, one look, wherever it appears.
[sub_resource type="StyleBoxFlat" id="close_style"]
content_margin_left = 0.0
content_margin_top = 0.0
content_margin_right = 0.0
content_margin_bottom = 0.0
bg_color = Color(0.027451, 0.098039, 0.094118, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.831373, 0.658824, 0.262745, 1)
corner_radius_top_left = 36
corner_radius_top_right = 36
corner_radius_bottom_right = 36
corner_radius_bottom_left = 36

; A recessed well, one step darker than the modal's own glass, so the two items
; read as two separate things being held up next to each other rather than as
; one continuous column of text. Deliberately trimmed in the DIM gold the
; unselected tab uses, not the bright rim: nothing inside a compare window is
; an action, and a bright gold box asks to be pressed.
[sub_resource type="StyleBoxFlat" id="well"]
content_margin_left = 20.0
content_margin_top = 16.0
content_margin_right = 20.0
content_margin_bottom = 16.0
bg_color = Color(0.043137, 0.117647, 0.109804, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.278431, 0.211765, 0.078431, 1)
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14

[node name="CompareFlyout" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
script = ExtResource("1_flyout")

[node name="Scrim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.011765, 0.035294, 0.058824, 0.72)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -470.0
offset_top = -450.0
offset_right = 470.0
offset_bottom = 450.0
grow_horizontal = 2
grow_vertical = 2
pivot_offset = Vector2(470, 450)

[node name="Layout" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Header" type="HBoxContainer" parent="Panel/Layout"]
custom_minimum_size = Vector2(0, 76)
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Panel/Layout/Header"]
layout_mode = 2
theme_type_variation = &"DisplayLabel"
theme_override_colors/font_color = Color(0.941176, 0.835294, 0.533333, 1)
theme_override_font_sizes/font_size = 48
text = "COMPARE"
vertical_alignment = 1

; Which hero this comparison is even about. Right-aligned against the close
; button rather than given its own line - it is a qualifier on the title, not a
; statement of its own.
[node name="ForLabel" type="Label" parent="Panel/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 30
horizontal_alignment = 2
vertical_alignment = 1

[node name="CloseButton" type="Button" parent="Panel/Layout/Header"]
custom_minimum_size = Vector2(72, 72)
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.94902, 0.913725, 0.815686, 1)
theme_override_font_sizes/font_size = 40
theme_override_styles/normal = SubResource("close_style")
theme_override_styles/pressed = SubResource("close_style")
theme_override_styles/hover = SubResource("close_style")
text = "X"

[node name="Columns" type="HBoxContainer" parent="Panel/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 18

[node name="Equipped" type="PanelContainer" parent="Panel/Layout/Columns"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/panel = SubResource("well")

[node name="Body" type="VBoxContainer" parent="Panel/Layout/Columns/Equipped"]
layout_mode = 2
size_flags_vertical = 0
theme_override_constants/separation = 6

[node name="Header" type="Label" parent="Panel/Layout/Columns/Equipped/Body"]
layout_mode = 2
theme_override_colors/font_color = Color(0.611765, 0.690196, 0.67451, 1)
theme_override_font_sizes/font_size = 24
text = "EQUIPPED"

; The rarity stripe from the shop card, turned on its side. It is the fastest
; read in the window - two bars of different colours say "this is a step up"
; before a single word has been parsed.
[node name="Rule" type="ColorRect" parent="Panel/Layout/Columns/Equipped/Body"]
custom_minimum_size = Vector2(0, 5)
layout_mode = 2
color = Color(0.721569, 0.698039, 0.768627, 1)

[node name="NameLabel" type="Label" parent="Panel/Layout/Columns/Equipped/Body"]
layout_mode = 2
theme_type_variation = &"DisplayLabel"
theme_override_font_sizes/font_size = 36
autowrap_mode = 3

[node name="SubtitleLabel" type="Label" parent="Panel/Layout/Columns/Equipped/Body"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
autowrap_mode = 3

[node name="Mods" type="VBoxContainer" parent="Panel/Layout/Columns/Equipped/Body"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="NoneLabel" type="Label" parent="Panel/Layout/Columns/Equipped/Body"]
layout_mode = 2
theme_override_colors/font_color = Color(0.611765, 0.690196, 0.67451, 1)
theme_override_font_sizes/font_size = 26
text = "Nothing equipped"

[node name="Candidate" type="PanelContainer" parent="Panel/Layout/Columns"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/panel = SubResource("well")

[node name="Body" type="VBoxContainer" parent="Panel/Layout/Columns/Candidate"]
layout_mode = 2
size_flags_vertical = 0
theme_override_constants/separation = 6

[node name="Header" type="Label" parent="Panel/Layout/Columns/Candidate/Body"]
layout_mode = 2
theme_override_colors/font_color = Color(0.941176, 0.835294, 0.533333, 1)
theme_override_font_sizes/font_size = 24
text = "THIS ITEM"

[node name="Rule" type="ColorRect" parent="Panel/Layout/Columns/Candidate/Body"]
custom_minimum_size = Vector2(0, 5)
layout_mode = 2
color = Color(0.721569, 0.698039, 0.768627, 1)

[node name="NameLabel" type="Label" parent="Panel/Layout/Columns/Candidate/Body"]
layout_mode = 2
theme_type_variation = &"DisplayLabel"
theme_override_font_sizes/font_size = 36
autowrap_mode = 3

[node name="SubtitleLabel" type="Label" parent="Panel/Layout/Columns/Candidate/Body"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
autowrap_mode = 3

[node name="Mods" type="VBoxContainer" parent="Panel/Layout/Columns/Candidate/Body"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Divider" type="HSeparator" parent="Panel/Layout"]
layout_mode = 2

[node name="ChangeHeader" type="Label" parent="Panel/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.941176, 0.835294, 0.533333, 1)
theme_override_font_sizes/font_size = 26
text = "IF YOU EQUIP THIS"

[node name="ChangeList" type="VBoxContainer" parent="Panel/Layout"]
custom_minimum_size = Vector2(0, 190)
layout_mode = 2
theme_override_constants/separation = 4
