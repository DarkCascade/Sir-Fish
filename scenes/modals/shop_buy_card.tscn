; A tight coin-shaped burst rather than the slot machine's wide confetti
; sheet (Tuning/slot_machine.tscn's confetti_mat) - this fires from a single
; point on the price plate, not across the whole cabinet width.
[sub_resource type="ParticleProcessMaterial" id="coin_burst_mat"]
emission_shape = 1
emission_sphere_radius = 6.0
direction = Vector3(0, -1, 0)
spread = 55.0
initial_velocity_min = 180.0
initial_velocity_max = 360.0
gravity = Vector3(0, 620, 0)
scale_min = 0.5
scale_max = 1.15
color = Color(0.960784, 0.874509, 0.627451, 1)

; [meshy-shop-pass] Full rebuild for mobile usability + juice (spec: Buy tab
; only). The card is now two stacked layers under Stage (a plain Control, so
; neither is fought by a Container's own layout pass - see shop_buy_card.gd):
; ActionLayer (a "Compare" lane pinned to the right edge, exposed by a
; leftward swipe) sits behind Face (the visible card, icon + info + a
; full-width BUY bar), which shop_buy_card.gd slides on drag. Root keeps
; clip_contents so the reveal - and the purchase burst - never spill past the
; card's own gold frame.
[node name="ShopBuyCard" type="PanelContainer"]
custom_minimum_size = Vector2(880, 300)
offset_right = 880.0
offset_bottom = 300.0
clip_contents = true
mouse_filter = 1
script = ExtResource("1_card")

[node name="Stage" type="Control" parent="."]
layout_mode = 2
mouse_filter = 1
script = ExtResource("4_stage")

[node name="ActionLayer" type="Control" parent="Stage"]
layout_mode = 1
anchor_left = 0.0
anchor_top = 0.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 0.0
offset_top = 0.0
offset_right = 0.0
offset_bottom = 0.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="ActionButton" type="Button" parent="Stage/ActionLayer"]
layout_mode = 1
anchor_left = 1.0
anchor_top = 0.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -184.0
offset_top = 0.0
offset_right = 0.0
offset_bottom = 0.0
grow_horizontal = 0
grow_vertical = 2
mouse_filter = 0
theme_override_colors/font_color = Color(0.858824, 0.945098, 1, 1)
theme_override_colors/font_hover_color = Color(1, 1, 1, 1)
theme_override_colors/font_pressed_color = Color(0.74902, 0.933333, 1, 1)
