; [meshy-shop-pass] The card face's rarity border/glow is set per-item at
; runtime (setup() duplicates this and overrides border_color/shadow_color),
; the same pattern edge.color = i.rarity_color() already used - a template
; stylebox here just supplies the shared shape (corners, margins, base fill).
[sub_resource type="StyleBoxFlat" id="face_style"]
content_margin_left = 26.0
content_margin_top = 20.0
content_margin_right = 26.0
content_margin_bottom = 20.0
bg_color = Color(0.043137, 0.117647, 0.109804, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.5, 0.5, 0.5, 1)
corner_radius_top_left = 18
corner_radius_top_right = 18
corner_radius_bottom_right = 18
corner_radius_bottom_left = 18
shadow_color = Color(0.5, 0.5, 0.5, 0)
shadow_size = 0

; The swipe-reveal lane behind the card, in the arcane teal/blue that means
; "info" everywhere else in the palette - deliberately not gold (BUY) or red
; (danger), so its colour alone says "this one is safe to tap".
