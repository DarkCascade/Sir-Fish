[node name="Value" type="Label" parent="Card/Content/Layout/StatRow/Health/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.937255, 0.839216, 0.580392, 1)
theme_override_font_sizes/font_size = 38
text = "0"
horizontal_alignment = 1

[node name="Defense" type="PanelContainer" parent="Card/Content/Layout/StatRow"]
