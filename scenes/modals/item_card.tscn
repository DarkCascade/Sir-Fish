layout_mode = 2
size_flags_vertical = 3
texture = ExtResource("5_atk")
expand_mode = 1
stretch_mode = 5

[node name="Value" type="Label" parent="Card/Content/Layout/StatRow/Attack/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.937255, 0.839216, 0.580392, 1)
theme_override_font_sizes/font_size = 38
text = "0"
horizontal_alignment = 1

[node name="Magic" type="PanelContainer" parent="Card/Content/Layout/StatRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/panel = SubResource("tile")

[node name="Box" type="VBoxContainer" parent="Card/Content/Layout/StatRow/Magic"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Icon" type="TextureRect" parent="Card/Content/Layout/StatRow/Magic/Box"]
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
size_flags_vertical = 3
texture = ExtResource("6_mag")
expand_mode = 1
stretch_mode = 5

[node name="Value" type="Label" parent="Card/Content/Layout/StatRow/Magic/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.937255, 0.839216, 0.580392, 1)
theme_override_font_sizes/font_size = 38
text = "0"
horizontal_alignment = 1

[node name="Health" type="PanelContainer" parent="Card/Content/Layout/StatRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/panel = SubResource("tile")

[node name="Box" type="VBoxContainer" parent="Card/Content/Layout/StatRow/Health"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Icon" type="TextureRect" parent="Card/Content/Layout/StatRow/Health/Box"]
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
size_flags_vertical = 3
texture = ExtResource("7_hp")
expand_mode = 1
