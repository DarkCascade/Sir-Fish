theme_override_styles/panel = SubResource("tile")

[node name="Box" type="VBoxContainer" parent="Card/Content/Layout/StatRow/Defense"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Icon" type="TextureRect" parent="Card/Content/Layout/StatRow/Defense/Box"]
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
size_flags_vertical = 3
texture = ExtResource("8_def")
expand_mode = 1
stretch_mode = 5

[node name="Value" type="Label" parent="Card/Content/Layout/StatRow/Defense/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.937255, 0.839216, 0.580392, 1)
theme_override_font_sizes/font_size = 38
text = "0"
horizontal_alignment = 1

; The vine frame at half thickness. A NinePatchRect always draws its corners
; 1:1 with the source texels, so shrinking the band by cutting patch_margin
; would slice the vine art in half instead of scaling it. Instead the node is
; laid out at TWICE the card rect (anchors of 2.0) and drawn at scale 0.5, so
; the 75px band lands as a 37.5px band with all 384px of art still in it -
; which also keeps it sharp on the 2x canvas_items upscale.
[node name="Frame" type="NinePatchRect" parent="Card"]
layout_mode = 1
anchor_right = 2.0
anchor_bottom = 2.0
scale = Vector2(0.5, 0.5)
mouse_filter = 2
texture = ExtResource("3_frame")
patch_margin_left = 75
patch_margin_top = 75
patch_margin_right = 75
patch_margin_bottom = 75
axis_stretch_horizontal = 2
axis_stretch_vertical = 2

; A brief rarity-coloured wash over the whole card, driven by flash_rarity().
; Declared after Frame so the wash covers the gold vines too - the old card
; flashed only the face, which read as a rectangle inside the frame.
[node name="RarityFlash" type="ColorRect" parent="Card"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(1, 1, 1, 0)

[node name="Actions" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Compare" type="Button" parent="Actions"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SecondaryButton"
text = "Compare"

[node name="Equip" type="Button" parent="Actions"]
layout_mode = 2
size_flags_horizontal = 3
text = "Equip"

[node name="Unequip" type="Button" parent="Actions"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SecondaryButton"
text = "Unequip"

[node name="Buy" type="Button" parent="Actions"]
layout_mode = 2
size_flags_horizontal = 3
text = "Buy"

[node name="Sell" type="Button" parent="Actions"]
layout_mode = 2
size_flags_horizontal = 3
text = "Sell"

[node name="Forge" type="Button" parent="Actions"]
layout_mode = 2
size_flags_horizontal = 3
text = "Forge"

[node name="Burst" type="GPUParticles2D" parent="."]
emitting = false
amount = 22
lifetime = 0.7
one_shot = true
explosiveness = 0.9
process_material = SubResource("burst_mat")
