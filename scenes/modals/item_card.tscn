patch_margin_left = 75
patch_margin_top = 75
patch_margin_right = 75
patch_margin_bottom = 75
axis_stretch_horizontal = 2
axis_stretch_vertical = 2

; A brief rarity-coloured wash over the whole card, driven by flash_rarity().
; Declared after Frame so the wash covers the gold vines too - the old card
; flashed only the face, which read as a rectangle inside the frame.
[node name="RarityFlash" type="ColorRect" parent="Card"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(1, 1, 1, 0)

