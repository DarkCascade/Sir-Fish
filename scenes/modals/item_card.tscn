[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/modals/item_card.gd" id="1_card"]
[ext_resource type="Script" path="res://scripts/modals/item_glyph.gd" id="2_glyph"]
[ext_resource type="Texture2D" path="res://assets/ui/reliquary/card_frame.png" id="3_frame"]
[ext_resource type="Texture2D" path="res://assets/ui/reliquary/card_medallion.png" id="4_med"]
[ext_resource type="Texture2D" path="res://assets/icons/bonus_sword.png" id="5_atk"]
[ext_resource type="Texture2D" path="res://assets/icons/bonus_bolt.png" id="6_mag"]
[ext_resource type="Texture2D" path="res://assets/icons/glyph_heal.png" id="7_hp"]
[ext_resource type="Texture2D" path="res://assets/icons/glyph_shield.png" id="8_def"]

; The inner plate. ItemCardStyle.apply() duplicates this and overrides
; bg/border/shadow per rarity - exactly as the four old card scenes did - so
; this only supplies the shared shape. Inset 56px from the card rect so the
; vine frame band overlaps its edge and the rarity border reads as an inner
; lip rather than a second outline competing with the gold.
[sub_resource type="StyleBoxFlat" id="backing"]
bg_color = Color(0.101961, 0.082353, 0.14902, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.5, 0.5, 0.5, 1)
corner_radius_top_left = 20
corner_radius_top_right = 20
corner_radius_bottom_right = 20
corner_radius_bottom_left = 20

; Modifier chip plate. border_color is re-tinted per rarity at runtime.
[sub_resource type="StyleBoxFlat" id="chip"]
content_margin_left = 6.0
content_margin_top = 6.0
content_margin_right = 6.0
content_margin_bottom = 6.0
bg_color = Color(0.14902, 0.117647, 0.219608, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.5, 0.5, 0.5, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

; Stat tile plate - a fixed gold rim, NOT rarity-tinted: the four tiles are a
; constant readout, and re-tinting them would compete with the border and the
; name for the same "what rarity is this" job.
[sub_resource type="StyleBoxFlat" id="tile"]
content_margin_left = 8.0
content_margin_top = 10.0
content_margin_right = 8.0
content_margin_bottom = 10.0
bg_color = Color(0.14902, 0.117647, 0.219608, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.478431, 0.407843, 0.235294, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

; Purchase burst, lifted verbatim from shop_buy_card.tscn so a buy on the
; universal card throws the same coin spray it always did.
[sub_resource type="ParticleProcessMaterial" id="burst_mat"]
emission_shape = 1
emission_sphere_radius = 6.0
direction = Vector3(0, -1, 0)
spread = 55.0
initial_velocity_min = 180.0
initial_velocity_max = 360.0
gravity = Vector3(0, 620, 0)
scale_min = 0.5
scale_max = 1.15
color = Color(0.960784, 0.874509, 0.627451, 1)

[node name="ItemCard" type="VBoxContainer"]
theme_override_constants/separation = 18
script = ExtResource("1_card")

[node name="Card" type="Control" parent="."]
custom_minimum_size = Vector2(0, 470)
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="Backing" type="PanelContainer" parent="Card"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 42.0
offset_top = 42.0
offset_right = -42.0
offset_bottom = -42.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("backing")

