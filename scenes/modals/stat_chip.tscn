[gd_scene format=3 uid="uid://f506uvq572k5"]

; [item-card] Restyled to the language the universal item card set: an icon
; plate with its value on its own line beneath in gold, then a dim caption.
;
; It used to pin the value in a pill overlapping the plate's top-right corner
; at the same 40px as the caption. Nothing else in the project puts a number
; outside the tile it belongs to, and at that size the captions wrapped to two
; lines of full-brightness text that collided with the next chip along. The
; number is now the same gold-on-plum numeral the card's stat tiles use, and
; the caption is demoted to a dim sub-label so the value reads first.

[ext_resource type="Script" uid="uid://30kbqun51qsw" path="res://scripts/modals/stat_chip.gd" id="1_chip"]

[sub_resource type="StyleBoxFlat" id="plate_default"]
bg_color = Color(0.054902, 0.043137, 0.086275, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.545098, 0.360784, 0.964706, 1)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_right = 16
corner_radius_bottom_left = 16
shadow_color = Color(0.545098, 0.360784, 0.964706, 0.32)
shadow_size = 6

; A fixed minimum height plus DEFAULT (begin) alignment, so chips whose caption
; wraps to two lines and chips whose caption fits on one still line their plates
; and values up across a row. Centring them instead pushed the short-caption
; chips half a line down from their neighbours.
[node name="StatChip" type="VBoxContainer" unique_id=1671733396]
custom_minimum_size = Vector2(140, 196)
size_flags_horizontal = 4
theme_override_constants/separation = 6
script = ExtResource("1_chip")

[node name="Plate" type="Control" parent="." unique_id=558433259]
custom_minimum_size = Vector2(104, 104)
layout_mode = 2
size_flags_horizontal = 4

[node name="IconClip" type="Control" parent="Plate" unique_id=225406222]
clip_contents = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Bg" type="PanelContainer" parent="Plate/IconClip" unique_id=1821748393]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("plate_default")

[node name="Icon" type="TextureRect" parent="Plate/IconClip" unique_id=679843506]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 6

[node name="Value" type="Label" parent="." unique_id=1795363124]
layout_mode = 2
theme_override_colors/font_color = Color(0.937255, 0.839216, 0.580392, 1)
theme_override_font_sizes/font_size = 36
text = "+0"
horizontal_alignment = 1

[node name="Caption" type="Label" parent="." unique_id=1163260119]
custom_minimum_size = Vector2(140, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.709804, 0.823529, 0.784314, 1)
theme_override_font_sizes/font_size = 22
text = "Stat"
horizontal_alignment = 1
autowrap_mode = 2
