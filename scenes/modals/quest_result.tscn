[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/modals/quest_result.gd" id="1_sum"]
[ext_resource type="PackedScene" uid="uid://46oh8n83yecw" path="res://scenes/console/sir_fish_tank.tscn" id="2_fish"]

; [move-elements-to-editor] Two things were built in code here and are authored
; now. Sir Fish (SummaryFish) was instanced and move_child'd to the top of the
; column; he is the first row of the VBox. And the twelve stat rows were a
; hardcoded table of HBox + two Labels; each is a real row now, named after the
; statistic it reports, carrying its own caption and a plausible dummy value so
; the whole screen reads in the editor.
;
; quest_result.gd fills the Value labels in by row NAME - so rows can be
; reordered, restyled or removed here without touching the script, and a row it
; has no number for simply keeps whatever the editor shows.

