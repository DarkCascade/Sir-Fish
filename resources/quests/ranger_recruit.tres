[resource]
script = ExtResource("1_qd")
id = &"ranger_recruit"
display_name = "The Ranger's Bow"
blurb = "A ranger has tracked the bandits who stole her bow into the wood. Bring it back, and she'll join you."
encounter_types = Array[int]([0, 1, 0, 2, 0])
gold_reward = 150
objectives = Array[QuestObjective]([ExtResource("2_obj")])
reward_extras = Array[QuestRewardExtra]([ExtResource("3_extra")])
enemy_pool = Array[StringName]([&"shadow_monster", &"skeleton_minion"])
boss_pool = Array[StringName]([&"bandit_officer"])
boss_drop_rarity_floor = 0
guaranteed_boss_drop = ExtResource("4_relic")
travel_durations = Array[float]([2.0, 3.0, 3.0, 3.0, 4.0])
level_range = Vector2i(3, 3)
unlock_level = 3
one_shot = true
