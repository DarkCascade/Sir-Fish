# Godot 4+ specific ignores
.godot/
/android/

# Exported build output (regenerated via export_project) and Blender's
# auto-backup of the previous save - neither is source.
/builds/
*.blend1

# Bytecode cache from the tools/ scripts (palette_audit.py imports itself when
# a sibling script reuses its luminance helpers, which writes this).
__pycache__/
*.pyc

# Third-party redistributable the character_pipeline extracts locally -
# not our source, too large to keep in history.
/third_party/kaykit/


# Throwaway look-at-it scenes and probes. CLAUDE.md and the backlog both already
# describe this folder as ignored; it was not actually listed until now.
scratch/
