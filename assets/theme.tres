; The content area behind the tabs. Empty on purpose - the modal's own
; PanelContainer already paints the glass, and a second filled panel inside it
; draws a visible box around the item list.
[sub_resource type="StyleBoxEmpty" id="tab_panel"]

[resource]
default_font = ExtResource("2_body")
default_font_size = 34
Button/colors/font_color = Color(0.960784, 0.945098, 0.894118, 1)
Button/colors/font_disabled_color = Color(0.478431, 0.501961, 0.470588, 1)
Button/colors/font_hover_color = Color(1, 0.988235, 0.945098, 1)
Button/colors/font_pressed_color = Color(0.831373, 0.658824, 0.262745, 1)
Button/styles/disabled = SubResource("btn_disabled")
Button/styles/hover = SubResource("btn_hover")
Button/styles/normal = SubResource("btn_normal")
Button/styles/pressed = SubResource("btn_pressed")
DisplayLabel/base_type = &"Label"
DisplayLabel/colors/font_outline_color = Color(0.019608, 0.054902, 0.062745, 1)
DisplayLabel/constants/outline_size = 5
DisplayLabel/fonts/font = ExtResource("1_display")
Label/colors/font_color = Color(0.960784, 0.945098, 0.894118, 1)
Panel/styles/panel = SubResource("stone_panel")
PanelContainer/styles/panel = SubResource("panel")
TabContainer/colors/font_selected_color = Color(0.960784, 0.874509, 0.627451, 1)
TabContainer/colors/font_unselected_color = Color(0.478431, 0.501961, 0.470588, 1)
TabContainer/colors/font_hovered_color = Color(1, 0.988235, 0.945098, 1)
TabContainer/font_sizes/font_size = 32
TabContainer/styles/panel = SubResource("tab_panel")
TabContainer/styles/tabbar_background = SubResource("tab_panel")
TabContainer/styles/tab_selected = SubResource("tab_selected")
TabContainer/styles/tab_unselected = SubResource("tab_unselected")
TabContainer/styles/tab_hovered = SubResource("tab_selected")

; [presentation redesign S3.4] Text-on-parchment variation - the upgrade
; cards (console/upgrade_button.gd) are the only parchment surface in the
; game, and dark ink on a light card face needs no outline; an outlined
; DisplayLabel there reads muddy.
PlateLabel/base_type = &"Label"
PlateLabel/colors/font_color = Color(0.141176, 0.117647, 0.078431, 1)
PlateLabel/constants/outline_size = 0

; See the btn2_* styleboxes above.
SecondaryButton/base_type = &"Button"
SecondaryButton/colors/font_color = Color(0.611765, 0.690196, 0.674510, 1)
SecondaryButton/colors/font_hover_color = Color(0.960784, 0.874509, 0.627451, 1)
SecondaryButton/colors/font_pressed_color = Color(0.831373, 0.658824, 0.262745, 1)
SecondaryButton/font_sizes/font_size = 28
SecondaryButton/styles/normal = SubResource("btn2_normal")
SecondaryButton/styles/hover = SubResource("btn2_hover")
SecondaryButton/styles/pressed = SubResource("btn2_pressed")
