[gd_resource type="FontVariation" format=3 load_steps=2]

[ext_resource type="FontFile" path="res://assets/fonts/Baloo2-Variable.ttf" id="1_baloo"]

; Baloo 2 (Google Fonts, SIL Open Font License - see assets/fonts/Baloo2-OFL.txt).
; The no-third-party-assets rule (spec 0.1.2) was a prototype-only constraint
; and no longer applies; this replaces the emboldened/skewed default-font
; synthesis with the variable font's own ExtraBold weight.
[resource]
base_font = ExtResource("1_baloo")
variation_opentype = {
"wght": 800.0
}
spacing_glyph = 2
